    <rules>
        <fullName>CD Send notification</fullName>
        <active>true</active>
        <criteriaItems>
            <field>Transaction__c.CD_Sent_Date__c</field>
            <operation>equals</operation>
        </criteriaItems>
        <description>This workflow will run when a transaction has a CD Send By Date approaching, but the CD has not been sent (CD Sent Date is blank).</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
            <actions>
                <name>Email_when_transaction_CD_Send_By_Date_is_approaching_with_no_CD_Sent_Date</name>
                <type>Alert</type>
            </actions>
            <offsetFromField>Transaction__c.CD_Sent_By_Date__c</offsetFromField>
            <timeLength>-14</timeLength>
            <workflowTimeTriggerUnit>Hours</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
    </rules>
