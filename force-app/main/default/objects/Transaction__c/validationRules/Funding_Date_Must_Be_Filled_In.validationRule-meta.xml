<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Funding_Date_Must_Be_Filled_In</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
   ISBLANK(Funding_Date__c),
   ISPICKVAL(Status__c, &apos;Post-Closed&apos;)
)</errorConditionFormula>
    <errorMessage>Please fill in the Funding Date before moving this Transaction to Post-Closed.</errorMessage>
</ValidationRule>
