<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cancelled</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status__c , &apos;Cancelled&apos;),
    OR(
        ISPICKVAL(Withdrawn_Reason__c , &quot;&quot;),
        ISBLANK(Withdrawn__c)
    )
)</errorConditionFormula>
    <errorMessage>You must fill in a Withdrawn Reason to move this Loan to Cancelled. Please use the &quot;Cancel Loan&quot; action.</errorMessage>
</ValidationRule>
