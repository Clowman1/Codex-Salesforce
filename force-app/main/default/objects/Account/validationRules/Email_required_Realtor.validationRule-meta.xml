<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Email_required_Realtor</fullName>
    <active>false</active>
    <errorConditionFormula>AND(  
    INCLUDES(Group__pc ,&apos;Realtor&apos;),
    ISBLANK( PersonEmail )
 )</errorConditionFormula>
