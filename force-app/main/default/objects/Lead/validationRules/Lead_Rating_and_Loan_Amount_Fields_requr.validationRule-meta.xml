<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lead_Rating_and_Loan_Amount_Fields_requr</fullName>
    <active>true</active>
    <errorConditionFormula>AND( ISPICKVAL(Status, &apos;Pre-Approval&apos;),
     OR( ISBLANK(TEXT(Rating)),
         ISBLANK(Loan_Amount__c)))</errorConditionFormula>
    <errorMessage>The &quot;Leader Rating&quot; and &quot;Loan Amount&quot; fields must be filled in before applying for pre-approval</errorMessage>
</ValidationRule>
