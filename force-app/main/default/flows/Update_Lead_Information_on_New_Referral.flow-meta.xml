    <description>Master referral flow that consolidates the logic previously split across Lead_Preferred_LO_Assigned, Copy_Realtor_Lead_Source_to_Lead, and AAssign_InIT_Webinar_Leadsssign_InIT_Webinar_Leads. It centralizes referral lead enrichment, owner routing, and notification handling in one after-save path to keep referral processing consistent and prevent overlapping automation.</description>
    <environments>Default</environments>
    <formulas>
        <name>BizDev</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!Get_Realtor_Account.Id})), TEXT({!Get_Realtor_Account.Biz_Dev_Designation__c}), &apos;Biz Dev - Reach&apos;)</expression>
    </formulas>
    <formulas>
        <name>EmailSubject</name>
        <dataType>String</dataType>
        <expression>&apos;Lead Assigned: &apos; &amp; {!$Record.FirstName} &amp; &apos; &apos; &amp; {!$Record.LastName}</expression>
    </formulas>
    <formulas>
        <name>JosephBrandonEmail</name>
        <dataType>String</dataType>
        <expression>IF({!LeadOwner} = &apos;005f2000009NwSsAAK&apos;, &apos;bbrotsky@reachhomeloans.com&apos;, &apos;jolmsted@reachhomeloans.com&apos;)</expression>
    </formulas>
    <formulas>
        <description>If Preferred LO selected - assigned as owner. Queue otherwise</description>
        <name>LeadOwner</name>
        <dataType>String</dataType>
        <expression>IF(
AND(
TEXT({!Get_Realtor_Account.PersonLeadSource}) = &apos;InIT Webinar&apos;,
NOT(ISBLANK({!Get_InIT_Webinar_Owner.Id}))
),
{!Get_InIT_Webinar_Owner.Id},
IF(
NOT(ISBLANK({!$Record.Preferred_LO__c})),
{!$Record.Preferred_LO__c},
&apos;00GQi0000032d5B&apos;
)
)</expression>
    </formulas>
    <formulas>
        <name>LeadSourceValue</name>
        <dataType>String</dataType>
        <expression>IF(
TEXT({!Get_Realtor_Account.PersonLeadSource}) = &apos;InIt Webinar&apos;,
&apos;InIt Webinar&apos;,
&apos;Realtor Referral&apos;
)</expression>
    </formulas>
    <formulas>
        <name>UserMobileOrPhone</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_User.Phone}), {!Get_User.MobilePhone}, {!Get_User.Phone})</expression>
    </formulas>
