        <locationX>176</locationX>
        <locationY>335</locationY>
        <inputAssignments>
            <field>Is_Realtor__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
