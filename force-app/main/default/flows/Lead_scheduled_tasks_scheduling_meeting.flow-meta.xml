        <label>Activity in last 7 days?</label>
        <locationX>182</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>No</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.LastActivityDate</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Last7days</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Task_to_Follow_Up</targetReference>
            </connector>
            <label>No</label>
        </rules>
    </decisions>
    <description>Scheduled flow on Lead object when record type is Realtor and status is Scheduling Meeting.  Creates a task weekly if Last Activity date is not within the last seven days.</description>
    <formulas>
        <name>Last7days</name>
        <dataType>Date</dataType>
        <expression>TODAY()-7</expression>
    </formulas>
    <formulas>
        <name>Today</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <interviewLabel>Lead - scheduled tasks, scheduling meeting {!$Flow.CurrentDateTime}</interviewLabel>
