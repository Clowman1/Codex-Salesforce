                </rightValue>
            </conditions>
            <connector>
                <targetReference>New_Reply_Email_Alert</targetReference>
            </connector>
            <label>Account</label>
        </rules>
        <rules>
            <name>Lead</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.TwilioSF__Lead__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>New_Reply_Email_Alert_0</targetReference>
            </connector>
            <label>Lead</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Later_than_6_PM</name>
        <label>Is Later than 6 PM?</label>
        <locationX>578</locationX>
        <locationY>384</locationY>
        <defaultConnector>
            <targetReference>Account_or_Lead</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Later_than_6_Pm</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CreatedDate</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Today_6PM</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_After_Hours_Emails</targetReference>
            </connector>
            <label>Later than 6 Pm</label>
        </rules>
    </decisions>
    <decisions>
        <name>Weekend_Hours</name>
        <label>Weekend Hours?</label>
        <locationX>314</locationX>
        <locationY>276</locationY>
        <defaultConnector>
            <targetReference>Is_Later_than_6_PM</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Send_Email_to_Brandon</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>DayOfWeek</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Saturday</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>DayOfWeek</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sunday</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Weekend_Emails</targetReference>
            </connector>
            <label>Send Email to Brandon</label>
        </rules>
    </decisions>
    <description>This flow will send a text message to the owner of an inbound message letting them know that they have received a reply. Updated Link to Record to reflect Production instead of the sandbox.

Updates in v25: 
Chris and Brandon&apos;s email addresses were removed from all notifications. All notifications (weekend, after hours, and standard) are now being forwarded to &quot;Insidesales@reachhomeloans.com&quot;. Logic to is still in place should the business choose to move back to separate notifications 
- Ose NCS 4.24.24</description>
    <environments>Default</environments>
    <formulas>
        <name>AccountBody</name>
        <dataType>String</dataType>
        <expression>&quot;You have a new reply in Salesforce from &quot; + {!$Record.TwilioSF__Account__r.FirstName} + &quot; &quot; +{!$Record.TwilioSF__Account__r.LastName} + &quot;. Please use the following link to view the record: https://reachhomeloans.lightning.force.com/lightning/r/Account/&quot; + {!$Record.TwilioSF__Account__c}+&quot;/view&quot;</expression>
    </formulas>
    <formulas>
        <name>AccountOrLeadName</name>
        <dataType>String</dataType>
        <expression>IF({!sObjectType} = &apos;Lead&apos;, {!$Record.TwilioSF__Lead__r.FirstName} + &quot; &quot; + {!$Record.TwilioSF__Lead__r.LastName}, {!$Record.TwilioSF__Account__r.FirstName} + &quot; &quot; + {!$Record.TwilioSF__Account__r.LastName})</expression>
    </formulas>
    <formulas>
        <name>DayOfWeek</name>
        <dataType>String</dataType>
        <expression>CASE(WEEKDAY({!$Flow.CurrentDate}),
1, &quot;Sunday&quot;,
2, &quot;Monday&quot;,
3, &quot;Tuesday&quot;,
4, &quot;Wednesday&quot;,
5, &quot;Thursday&quot;,
6, &quot;Friday&quot;,
7, &quot;Saturday&quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>FromAccount</name>
        <dataType>String</dataType>
        <expression>&quot;You have a new reply in Salesforce from &quot; + {!$Record.TwilioSF__Account__r.FirstName} + &quot; &quot; +{!$Record.TwilioSF__Account__r.LastName} + &quot;. Please use the following link to view it in the Salesforce Mobile App: https://reachhomeloans.lightning.force.com/lightning/r/Account/&quot; + {!$Record.TwilioSF__Account__c} + &quot;/view&quot;</expression>
    </formulas>
    <formulas>
        <name>FromLead</name>
        <dataType>String</dataType>
        <expression>&quot;You have a new reply in Salesforce from &quot; + {!$Record.TwilioSF__Lead__r.FirstName} + &quot; &quot; +{!$Record.TwilioSF__Lead__r.LastName} + &quot;. Please use the following link to view it in the Salesforce Mobile App: https://reachhomeloans.lightning.force.com/lightning/r/Lead/&quot; + {!$Record.TwilioSF__Lead__c} + &quot;/view&quot;</expression>
    </formulas>
    <formulas>
        <name>LeadBody</name>
        <dataType>String</dataType>
        <expression>&quot;You have a new reply in Salesforce from &quot; + {!$Record.TwilioSF__Lead__r.FirstName} + &quot; &quot; +{!$Record.TwilioSF__Lead__r.LastName} + &quot;. Please use the following link to view the record: https://reachhomeloans.lightning.force.com/lightning/r/Lead/&quot; + {!$Record.TwilioSF__Lead__c}+&quot;/view&quot;</expression>
    </formulas>
    <formulas>
        <name>sObjectRecordId</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.TwilioSF__Lead__c}), {!$Record.TwilioSF__Account__c}, {!$Record.TwilioSF__Lead__c})</expression>
    </formulas>
    <formulas>
        <name>sObjectType</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.TwilioSF__Lead__c}), &quot;Account&quot;, &quot;Lead&quot;)</expression>
    </formulas>
    <formulas>
        <name>Today_6PM</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TEXT(TODAY()) &amp; &quot; 18:00:00&quot;)</expression>
    </formulas>
    <interviewLabel>Alert Message Owner of New Reply {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Alert Message Owner of New Reply</label>
