    <decisions>
        <name>Account_or_Lead</name>
        <label>Account or Lead?</label>
        <locationX>842</locationX>
        <locationY>492</locationY>
        <defaultConnector>
            <targetReference>New_Reply_Email_Alert_0_0</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Owner of Message</defaultConnectorLabel>
        <rules>
            <name>Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.TwilioSF__Account__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
