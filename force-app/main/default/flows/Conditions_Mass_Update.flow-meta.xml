    <formulas>
        <name>AssignedToValue</name>
        <dataType>String</dataType>
        <expression>IF(
   ISBLANK({!AssignedTo.recordId}) , {!For_Each_Condition.Assigned_To__c} , {!AssignedTo.recordId}
 )</expression>
    </formulas>
    <formulas>
        <name>BorrowerCanSee</name>
        <dataType>Boolean</dataType>
        <expression>IF(
      {!Borrower_Can_See_Condition_In_Portal} == &quot;&quot; , {!For_Each_Condition.Can_Borrower_See__c} , 
       IF(
            {!Borrower_Can_See_Condition_In_Portal} == &quot;Yes&quot;, true, false
          )
   
   )</expression>
    </formulas>
    <formulas>
        <name>ConditionStatus</name>
        <dataType>String</dataType>
        <expression>IF(
  {!Condition_Status} == &quot;&quot;  , TEXT({!For_Each_Condition.Status__c}) , {!Condition_Status}
 )</expression>
    </formulas>
    <formulas>
        <name>ETADate</name>
        <dataType>Date</dataType>
        <expression>IF(
   ISBLANK( {!ETA_Date} ) , {!For_Each_Condition.ETA__c} , {!ETA_Date}
 )</expression>
    </formulas>
    <formulas>
        <name>IncludeInEmail</name>
        <dataType>Boolean</dataType>
        <expression>IF(
      {!Include_In_Next_Email} == &quot;&quot; ,  {!For_Each_Condition.Include_In_Email__c} , 
       IF(
            {!Include_In_Next_Email} == &quot;Yes&quot;, true, false
          )
   
   )</expression>
    </formulas>
    <formulas>
