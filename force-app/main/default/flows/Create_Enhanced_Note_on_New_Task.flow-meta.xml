    <decisions>
        <name>Create_Note_For_Comments</name>
        <label>Create Note For Comments?</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>Dummy_Assignment</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Create_Note_For_Comments</name>
            <conditionLogic>(1 OR 3 OR 4) AND 2</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Subject</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Call</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Description</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Subject</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>SMS</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Call</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Dummy_Assignment</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>This flow will check if the Comments on a task or call have been filled in. If so and the &quot;Create Enhanced Note&quot; checkbox is true, an enhanced note will be created with the comments left on the task. Filtered to only completed tasks of Subtype &quot;Call&quot;.</description>
    <environments>Default</environments>
    <formulas>
        <name>EnhancedNoteType</name>
        <dataType>String</dataType>
        <expression>IF(
  OR(
    CONTAINS(({!$Record.Subject}), &quot;SMS&quot;),
    CONTAINS(({!$Record.Subject}), &quot;texted&quot;),
    ISPICKVAL({!$Record.InteractionType__c}, &quot;Sms&quot;)
  ),
  &quot;Text&quot;,
  IF(
    OR(
      CONTAINS(({!$Record.Subject}), &quot;Call&quot;),
      ISPICKVAL({!$Record.InteractionType__c}, &quot;Call&quot;)
    ),
    &quot;Call&quot;,
    &quot;Note&quot;
  )
)</expression>
    </formulas>
    <formulas>
        <name>LeadId</name>
        <dataType>String</dataType>
        <expression>IF(BEGINS({!$Record.WhoId}, &quot;003&quot;), &quot;&quot;, {!$Record.WhoId})</expression>
    </formulas>
    <interviewLabel>Create Enhanced Note on New Task {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create Enhanced Note on New Task</label>
