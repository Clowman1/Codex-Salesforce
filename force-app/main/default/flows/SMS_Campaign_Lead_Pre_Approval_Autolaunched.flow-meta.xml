    <formulas>
        <name>HolidayInfoMessage</name>
        <dataType>String</dataType>
        <expression>&apos;Postponed. Today is a holiday: &apos; &amp; {!Get_Holiday_Today.Name}</expression>
    </formulas>
    <formulas>
        <name>In7Days</name>
        <dataType>DateTime</dataType>
        <expression>NOW() + 7</expression>
    </formulas>
    <formulas>
        <name>NextDay</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 1</expression>
    </formulas>
    <formulas>
        <name>NextSendDateTimeAfterEmailActivity</name>
        <dataType>DateTime</dataType>
        <expression>IF(
    AND(
        ISBLANK({!Lead_Get_Email_Message_Relation.Id}),
        ISBLANK({!Contact_Get_Email_Message_Relation.Id})
    ),
    {!In7Days},
    IF(
        ISBLANK({!Contact_Get_Email_Message_Relation.Id}),
        {!Lead_Get_Email_Message_Relation.CreatedDate} + 7,
        IF(
            ISBLANK({!Lead_Get_Email_Message_Relation.Id}),
            {!Contact_Get_Email_Message_Relation.CreatedDate} + 7,
            IF(
                {!Contact_Get_Email_Message_Relation.CreatedDate} &gt; {!Lead_Get_Email_Message_Relation.CreatedDate},
                {!Contact_Get_Email_Message_Relation.CreatedDate} + 7,
                {!Lead_Get_Email_Message_Relation.CreatedDate} + 7
            )
        )
    )
)</expression>
    </formulas>
    <formulas>
        <name>NextSendDateTimeAfterRecentScheduledMessage</name>
        <dataType>DateTime</dataType>
        <expression>IF(
    OR(
        ISBLANK({!Get_Recent_Scheduled_Message.Id}),
        ISBLANK({!Get_Recent_Scheduled_Message.Sent_DateTime__c})
    ),
    {!In7Days},
    {!Get_Recent_Scheduled_Message.Sent_DateTime__c} + 7
)</expression>
    </formulas>
    <formulas>
        <name>NextSendDateTimeAfterRingCentralActivity</name>
        <dataType>DateTime</dataType>
        <expression>IF(
    AND(
        ISBLANK({!Get_Lead.Last_Call_Attempt_RingCentral__c}),
        ISBLANK({!Get_Lead.Last_SMS_Attempt_RingCentral__c})
    ),
    {!In7Days},
    IF(
        ISBLANK({!Get_Lead.Last_Call_Attempt_RingCentral__c}),
        {!Get_Lead.Last_SMS_Attempt_RingCentral__c} + 7,
        IF(
            ISBLANK({!Get_Lead.Last_SMS_Attempt_RingCentral__c}),
            {!Get_Lead.Last_Call_Attempt_RingCentral__c} + 7,
            IF(
                {!Get_Lead.Last_Call_Attempt_RingCentral__c} &gt; {!Get_Lead.Last_SMS_Attempt_RingCentral__c},
                {!Get_Lead.Last_Call_Attempt_RingCentral__c} + 7,
                {!Get_Lead.Last_SMS_Attempt_RingCentral__c} + 7
            )
        )
    )
)</expression>
    </formulas>
    <formulas>
        <name>NextSMSTemplate</name>
        <dataType>String</dataType>
        <expression>CASE(
    {!Get_Scheduled_Message.Template_ID__c},
    &apos;00XQi000008PhA1MAK&apos;, &apos;00XQi000008PhDFMA0&apos;,
    &apos;00XQi000008PhDFMA0&apos;, &apos;00XQi000008PhGTMA0&apos;,
    &apos;00XQi000008PhGTMA0&apos;, &apos;00XQi000008PhI5MAK&apos;,
    &apos;00XQi000008PhI5MAK&apos;, &apos;00XQi000008PhLJMA0&apos;,
    &apos;00XQi000008PhLJMA0&apos;, &apos;00XQi000008PhQ9MAK&apos;,
    &apos;00XQi000008PhQ9MAK&apos;, &apos;00XQi000008PhbRMAS&apos;,
    &apos;00XQi000008PhbRMAS&apos;, &apos;00XQi000008PhefMAC&apos;,
    &apos;00XQi000008PhefMAC&apos;, &apos;00XQi000008PhhtMAC&apos;,
    &apos;00XQi000008PhhtMAC&apos;, &apos;00XQi000008Phl7MAC&apos;,
    &apos;00XQi000008Phl7MAC&apos;, &apos;00XQi000008PhmjMAC&apos;,
    &apos;00XQi000008PhmjMAC&apos;, &apos;00XQi000008PhoLMAS&apos;,
    null
)</expression>
    </formulas>
    <formulas>
        <name>TaskDescription</name>
        <dataType>String</dataType>
        <expression>&apos;Scheduled Message Record ID: &apos; &amp; {!Get_Scheduled_Message.Id}</expression>
    </formulas>
    <formulas>
        <name>TaskSubject</name>
