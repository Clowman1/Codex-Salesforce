    <formulas>
        <name>FromNumber</name>
        <dataType>String</dataType>
        <expression>RIGHT({!$Record.rcsfl__from_number__c}, LEN({!$Record.rcsfl__from_number__c}) - 2)</expression>
    </formulas>
    <formulas>
        <description>To Phone number in format &quot;(347) 111-1111&quot;</description>
        <name>FromNumberFormatted</name>
        <dataType>String</dataType>
        <expression>IF(
     LEN({!$Record.rcsfl__from_number__c}) = 12,
     &apos;(&apos; &amp; MID({!$Record.rcsfl__from_number__c}, 3, 3) &amp; &apos;) &apos; &amp; MID({!$Record.rcsfl__from_number__c}, 6, 3) &amp; &apos;-&apos; &amp; MID({!$Record.rcsfl__from_number__c}, 9, 4),
     {!$Record.rcsfl__from_number__c}
)</expression>
    </formulas>
    <formulas>
        <name>InboundWhoId</name>
        <dataType>String</dataType>
        <expression>IF(
ISBLANK({!Get_Inbound_Lead.Id}), {!Get_Inbound_Contact.Id}, {!Get_Inbound_Lead.Id}
)</expression>
    </formulas>
    <formulas>
        <name>OutboundWhoId</name>
