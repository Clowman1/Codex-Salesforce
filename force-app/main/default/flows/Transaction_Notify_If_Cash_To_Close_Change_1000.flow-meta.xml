    <formulas>
        <name>CashToCloseChange</name>
        <dataType>Currency</dataType>
        <expression>IF(
    AND(
        NOT(ISBLANK({!$Record.Cash_To_Close__c})),
        NOT(ISBLANK({!$Record__Prior.Cash_To_Close__c}))
    ),
    {!$Record.Cash_To_Close__c} - {!$Record__Prior.Cash_To_Close__c},
    0
)</expression>
