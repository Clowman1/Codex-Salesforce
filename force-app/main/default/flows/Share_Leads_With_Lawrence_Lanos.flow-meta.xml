    <decisions>
        <name>Is_Realtor_Group_a_Nickley_Group</name>
        <label>Is Realtor Group a Nickley Group?</label>
        <locationX>446</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Get_Existing_Sharing</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Referral_Source__r.Account.Realtor_Group__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>The Nickley Group</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Realtor_Buying_Agent__r.Realtor_Group__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>The Nickley Group</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Referred_By__r.Realtor_Group__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>The Nickley Group</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Share_Record</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
