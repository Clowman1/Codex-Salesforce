    <start>
        <locationX>320</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Realtor_Group_a_Nickley_Group</targetReference>
        </connector>
        <filterFormula>OR(
    AND(
        ISNEW(),
        OR(
            NOT(ISBLANK(TEXT({!$Record.Referral_Source__r.Account.Realtor_Group__c}))),
            NOT(ISBLANK(TEXT({!$Record.Realtor_Buying_Agent__r.Realtor_Group__c}))),
            NOT(ISBLANK(TEXT({!$Record.Referred_By__r.Realtor_Group__c})))
        )
    ),
    ISCHANGED({!$Record.Referral_Source__c}),
    ISCHANGED({!$Record.Realtor_Buying_Agent__c}),
    ISCHANGED({!$Record.Referred_By__r.Realtor_Group__c})
)</filterFormula>
