    <description>This flow will send a custom message to a Lead&apos;s Buyer Agent when the &quot;External Message to Buyer&apos;s Agent&quot; field is filled in while logging a call in Salesforce. The body of the text will be exactly what is entered in the field on the task.</description>
    <environments>Default</environments>
    <formulas>
        <name>External_Message</name>
        <dataType>String</dataType>
        <expression>IF(OR(
ISBLANK({!$Record.External_Message_to_Buyer_s_Agent_Contin__c}), 
ISNULL({!$Record.External_Message_to_Buyer_s_Agent_Contin__c})
),
{!$Record.External_Message_to_Buyer_s_Agent__c},
{!$Record.External_Message_to_Buyer_s_Agent__c} + {!$Record.External_Message_to_Buyer_s_Agent_Contin__c}
)</expression>
    </formulas>
