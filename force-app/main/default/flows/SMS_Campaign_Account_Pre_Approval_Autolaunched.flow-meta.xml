    <formulas>
        <name>TodayDayOfMonth</name>
        <dataType>Number</dataType>
        <expression>DAY({!$Flow.CurrentDate})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>TodayMonthOfYear</name>
        <dataType>Number</dataType>
        <expression>MONTH({!$Flow.CurrentDate})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>TodayMonthOfYearName</name>
        <dataType>String</dataType>
        <expression>CASE(
    MONTH({!$Flow.CurrentDate}),
    1, &quot;January&quot;,
    2, &quot;February&quot;,
    3, &quot;March&quot;,
    4, &quot;April&quot;,
    5, &quot;May&quot;,
    6, &quot;June&quot;,
    7, &quot;July&quot;,
    8, &quot;August&quot;,
    9, &quot;September&quot;,
    10, &quot;October&quot;,
    11, &quot;November&quot;,
    12, &quot;December&quot;,
    &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>X7DaysAgo</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - 7</expression>
    </formulas>
