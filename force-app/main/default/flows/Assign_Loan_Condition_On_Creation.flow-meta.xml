    <formulas>
        <name>ConditionName</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.Transaction_Condition_Reference__r.Borrower_Label__c}),
{!$Setup.UWMSettings__c.Default_Condition_Name__c},
{!$Record.Transaction_Condition_Reference__r.Borrower_Label__c})</expression>
    </formulas>
    <formulas>
        <name>Description</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.Transaction_Condition_Reference__r.Borrower_Description__c}),{!$Record.UWM_Description__c},{!$Record.Transaction_Condition_Reference__r.Borrower_Description__c})</expression>
    </formulas>
    <formulas>
        <name>fx_Role_Contains_Loan_Officer</name>
        <dataType>Boolean</dataType>
        <expression>OR(CONTAINS(LOWER(TEXT({!$Record.Transaction_Condition_Reference__r.AssignedToRole__c})), &quot;loan officer&quot;), AND(CONTAINS(LOWER(TEXT({!$Record.Transaction_Condition_Reference__r.AssignedToRole__c})), &quot;officer&quot;), NOT(CONTAINS(LOWER(TEXT({!$Record.Transaction_Condition_Reference__r.AssignedToRole__c})), &quot;processor&quot;))))</expression>
    </formulas>
    <formulas>
        <name>fx_Role_Contains_Processor</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS(LOWER(TEXT({!$Record.Transaction_Condition_Reference__r.AssignedToRole__c})), &quot;processor&quot;)</expression>
    </formulas>
    <formulas>
        <name>Type</name>
        <dataType>String</dataType>
        <expression>IF(
ISPICKVAL({!$Record.Transaction_Condition_Reference__r.Type__c}, &apos;Loan Officer&apos;),
&apos;Loan Officer&apos;,
IF(
ISPICKVAL({!$Record.Transaction_Condition_Reference__r.Type__c}, &apos;Vendor&apos;),
&apos;Vendor&apos;,
IF(
ISPICKVAL({!$Record.Transaction_Condition_Reference__r.Type__c}, &apos;Post Closing&apos;),
&apos;Post Closing&apos;,
&apos;Processor&apos;
)))</expression>
    </formulas>
