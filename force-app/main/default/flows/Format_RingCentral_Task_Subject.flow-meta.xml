    <description>This flow will alter the existing format of RingCentral Tasks to: &quot;Client Called User&quot; or &quot;User Called Client for M:SS on (current date/time)&quot;.</description>
    <environments>Default</environments>
    <formulas>
        <name>CallDurationInMinutes</name>
        <dataType>String</dataType>
        <expression>IF((MOD(({!$Record.CallDurationInSeconds})/60,1)*60) &gt; 10,
TEXT(FLOOR( ({!$Record.CallDurationInSeconds})/60)) + &quot;:&quot; + TEXT( FLOOR(MOD(({!$Record.CallDurationInSeconds})/60,1)*60) ),
TEXT(FLOOR( ({!$Record.CallDurationInSeconds})/60)) + &quot;:0&quot; + TEXT( FLOOR(MOD(({!$Record.CallDurationInSeconds})/60,1)*60) )
)</expression>
    </formulas>
    <formulas>
        <name>OutboundInboundLead</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!$Record.Subject}, &quot;Outbound&quot;), ({!$Record.Owner:User.FirstName}) + &quot; Called &quot; +{!ClientName}, {!ClientName} + &quot; Called &quot; + ({!$Record.Owner:User.FirstName}))</expression>
    </formulas>
    <formulas>
        <name>Subject</name>
        <dataType>String</dataType>
        <expression>{!OutboundInboundLead}</expression>
    </formulas>
    <formulas>
        <name>UserName</name>
        <dataType>String</dataType>
        <expression>{!$User.FirstName} + &quot; &quot; + {!$User.LastName}</expression>
    </formulas>
