    <decisions>
        <name>Check_Case_Appraisal_Ordered_But_Not_Received_Yet</name>
        <label>Check Case: Appraisal Ordered But Not Received Yet</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Appraisal_Ordered_But_Not_Received_Yet</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Appraisal_1_Received_Date__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Appraisal_1_Ordered_Date__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>X7DaysPassedSinceOrderDate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email_Appraisal_Not_Received</targetReference>
            </connector>
            <label>Appraisal Ordered But Not Received Yet</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Case_Status_In_Pre_Processing_But_No_Appraisal_Ordered</name>
        <label>Check Case: Status In Pre-Processing But No Appraisal Ordered</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Check_Case_Appraisal_Ordered_But_Not_Received_Yet</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Appraisal_Not_Ordered_Yet</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Appraisal_1_Ordered_Date__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pre-Processing</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>X7DaysPassedSinceCreationDate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email_Appraisal_Not_Ordered</targetReference>
            </connector>
            <label>Yes - Appraisal Not Ordered Yet</label>
        </rules>
    </decisions>
    <decisions>
