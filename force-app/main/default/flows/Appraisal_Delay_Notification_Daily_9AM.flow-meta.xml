    </formulas>
    <formulas>
        <name>X7DaysPassedSinceCreationDate</name>
        <dataType>Boolean</dataType>
        <expression>(NOW() - {!$Record.CreatedDate}) &gt;= 7</expression>
    </formulas>
    <formulas>
        <name>X7DaysPassedSinceOrderDate</name>
