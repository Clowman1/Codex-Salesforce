    <formulas>
        <name>GenericUploadConditionName</name>
        <dataType>String</dataType>
        <expression>&quot;Generic Upload - &quot; + TEXT(MONTH(DATEVALUE({!$Flow.CurrentDateTime}))) &amp; &quot;/&quot; &amp;
TEXT(DAY(DATEVALUE({!$Flow.CurrentDateTime}))) &amp; &quot;/&quot; &amp;
TEXT(YEAR(DATEVALUE({!$Flow.CurrentDateTime}))) &amp; &quot; &quot; &amp; 
IF(VALUE(MID(TEXT({!$Flow.CurrentDateTime}), 12, 2)) &gt; 12, 
    TEXT(VALUE(MID(TEXT({!$Flow.CurrentDateTime}), 12, 2)) - 12), 
    MID(TEXT({!$Flow.CurrentDateTime}), 12, 2)) &amp; &quot;:&quot; &amp; 
MID(TEXT({!$Flow.CurrentDateTime}), 15, 2) &amp; 
IF(VALUE(MID(TEXT({!$Flow.CurrentDateTime}), 12, 2)) &gt;= 12, &quot; PM&quot;, &quot; AM&quot;)</expression>
    </formulas>
    <formulas>
        <name>GenericUploadOwner</name>
        <dataType>String</dataType>
        <expression>IF({!$Setup.Condition_Settings__c.Generic_Upload_Owner__c} = &quot;Loan Officer&quot;, {!Get_Related_Loan.Loan_Officer__c}, IF({!$Setup.Condition_Settings__c.Generic_Upload_Owner__c} = &quot;Loan Processor&quot;, {!Get_Related_Loan.Processor__c}, {!Get_Related_Loan.OwnerId}))</expression>
    </formulas>
    <formulas>
        <name>i_plus_plus</name>
        <dataType>Number</dataType>
        <expression>{!i} + 1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>Occurrences_of_comma_max</name>
        <dataType>Number</dataType>
        <expression>(LEN({!$Record.Target_Record_Id__c}) - LEN(SUBSTITUTE(LOWER({!$Record.Target_Record_Id__c}),&quot;,&quot;,&quot;&quot;)))</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>recordIdDisplay_split</name>
        <dataType>String</dataType>
        <expression>LEFT({!recordIdDisplay_original}, FIND(&apos;,&apos;, {!recordIdDisplay_original})-1)</expression>
    </formulas>
    <formulas>
        <name>recordIdDisplay_substitute</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!recordIdDisplay_original}, {!recordIdDisplay_split} &amp; &apos;,&apos;, &apos;&apos;)</expression>
    </formulas>
