        <locationX>1115</locationX>
        <locationY>572</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Aleady_In_Contact_Attempt</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_lead.Status</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Contact Attempt</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Contact_Attempts</targetReference>
            </connector>
            <label>Aleady In Contact Attempt</label>
        </rules>
        <rules>
            <name>In_Prior_Condition</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>get_lead.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Contacted/Call Back</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>get_lead.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Contact_Attempts_0</targetReference>
            </connector>
            <label>In Prior Condition</label>
        </rules>
    </decisions>
