    @InvocableMethod(label = 'Extract data from Call Log and put in Application Template')
    public static void getExtractedData(List<String> taskIds) {
        
        for (String taskId : taskIds) {
            Task task = [SELECT WhoId, Description FROM Task WHERE Id = :taskId];
            Lead lead = [SELECT Id, Lead_Notes_JSON__c FROM Lead WHERE Id = :task.WhoId];
            
            String initialJson = JSON_STRUCT;
            if (String.isNotBlank(lead.Lead_Notes_JSON__c)) {
                initialJson = lead.Lead_Notes_JSON__c;
            }
            
            try {
                String prompt = PROMPT_SAMPLE.replace('{{{CALL_LOG}}}', extractCallLog(task.Description));
                prompt = prompt.replace('{{{JSON_DATA}}}', initialJson);
                String response = ChatGPTService.sendPrompt(prompt);
                
                Custom_Log__c successLog = new Custom_Log__c(Source__c = 'SUCCESS: OpenAI Call Extraction Log: ' + task.Id, Data__c = response, Lead__c = lead.Id);
                insert successLog;
                
                Custom_Log__c preservationLog = new Custom_Log__c(Source__c = 'ARCHIVE: Application Template JSON for Lead: ' + lead.Id, Data__c = initialJson, Lead__c = lead.Id);
                insert preservationLog;
                
                lead.Lead_Notes_JSON__c = response;
                update lead;
            } catch (Exception e) {
                Custom_Log__c errorLog = new Custom_Log__c(Source__c = 'FAILURE: OpenAI Call Extraction Log: ' + task.Id, Data__c = e.getMessage());
                insert errorLog;
            }
        }
    }
    
    public static String extractCallLog(String input) {
        Pattern pattern = Pattern.compile('00:\\d{2}(:\\d{2})?');
        Matcher matcher = pattern.matcher(input);
        
        if (matcher.find()) {
            Integer startIndex = matcher.start();
            return input.substring(startIndex).trim();
        } else {
            throw new AuraHandledException('No call details specified on Task');
        }
    }
    
