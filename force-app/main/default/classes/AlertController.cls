public with sharing class AlertController {
    @AuraEnabled
    public static  Map<String,Object> getEmptyFieldsFromLoan(String loanId, String metadataId){
        Transaction__c trans= TransactionRepository.getInstance().getTransactionById(loanId);
        List<Alert_Field__mdt> emptyFields = new List<Alert_Field__mdt>();
        SObject obj = (SObject)trans;
        Decimal percentOfFieldsMissing;
        Alert__mdt alert = [SELECT Id, Title__c, Complete_Message__c, Incomplete_Message__c, (SELECT Id, Alert__c, API_Name__c, Title__c FROM Alert_Fields__r) FROM Alert__mdt WHERE Id =:metadataId];
        for(Alert_Field__mdt field : alert.Alert_Fields__r){
            if(obj.get(String.valueOf(field.API_Name__c)) == null){
                emptyFields.add(field);
            }
        }
        Decimal numOfEmptyFields = emptyFields.size();
        Decimal numOfAlertFields = alert.Alert_Fields__r.size();
        if(alert.Alert_Fields__r.size() != 0){
            percentOfFieldsMissing = (numOfEmptyFields/numOfAlertFields)*100;
        }
        else{
            percentOfFieldsMissing = 0;
        }

        return new Map<String, Object>{
                'alert' => alert,
                'emptyFields' => emptyFields,
                'percentOfFieldsMissing' => percentOfFieldsMissing
        };
    }
    
