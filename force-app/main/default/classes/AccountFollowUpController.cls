public class AccountFollowUpController {

    @InvocableMethod(label = 'Follow Up: Create Leads from provided Accounts')
    public static void createAccounts(List<Input> inputs) {
        for (Input i : inputs) {
            if (String.isNotBlank(i.userId)) {
                System.enqueueJob(new CreateLeadQueueable(i.accounts, i.userId));
            } else if (String.isNotBlank(i.queueId)) {
                System.enqueueJob(new CreateLeadQueueable(i.accounts, i.queueId));
            }
        }
    }
    
    public class Input {
        @InvocableVariable public List<Account> accounts;
        @InvocableVariable public String queueId;
        @InvocableVariable public String userId;
    }
    
    public class CreateLeadQueueable implements Queueable {
        private final Integer BATCH_SIZE = 10;
        private List<Account> accountsToProcess;
        private List<Account> remainingAccounts;
        
        private String ownerId;
        
        public CreateLeadQueueable(List<Account> accounts, String ownerId) {
            this.ownerId = ownerId;
            accountsToProcess = new List<Account>(); 
            for (Integer i = 0; i < BATCH_SIZE && !accounts.isEmpty(); i++) {
                accountsToProcess.add(accounts.remove(0));
            }
            remainingAccounts = accounts;
        }
        
        public void execute(QueueableContext context) { 
            
            List<Lead> leadsToCreate = new List<Lead>();
            Set<Id> accountIds = new Set<Id>();
            
            try {
                
                for (Account a : accountsToProcess) {
                    
                    Lead l = new Lead();
                    l.LTV__c = a.Most_Recent_LTV__c;
                    l.Loan_Amount__c = a.Most_Recent_Loan_Amount__c;
                    l.Loan_Program__c = a.Most_Recent_Loan_Program_1st__c;
                    l.Loan_Purpose__c = a.Loan_Purpose__pc;
                    l.Loan_Type_1st_TD__c = a.Most_Recent_Loan_Type_1st_TD__c;
                    l.Interest_Rate__c = a.Most_Recent_Rate__c;
                    l.FirstName = a.FirstName;
                    l.LastName = a.LastName;
                    l.LeadSource = 'Past Client';
                    l.OwnerId = ownerId;
                    l.Phone = a.Phone;
                    l.Email = a.PersonEmail;
                    l.Follow_Up_Account__c = a.Id;
                    
                    leadsToCreate.add(l);
                    
                    //a.Follow_Up_Lead_Created__c = true;
                    accountIds.add(a.Id);
                    
                    
                    
                }
                
                if (leadsToCreate.size() > 0) {
                    insert leadsToCreate;
                }
                
                if (accountIds.size() > 0) {

                    List<Account> originAccounts = [SELECT Id, Follow_Up_Lead_Created__c FROM Account WHERE Id IN :accountIds];
                    for (Account acc : originAccounts) {
                        acc.Follow_Up_Lead_Created__c = true;
                    }
                    update originAccounts;
                }
                
            } catch (Exception e) {
                System.debug('Error: ' + e.getMessage() + e.getStackTraceString());
            }


            if (remainingAccounts.size() > 0) {
                System.enqueueJob(new CreateLeadQueueable(remainingAccounts, ownerId));
            }
        }
    }
    
