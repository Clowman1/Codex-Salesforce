public without sharing class ChatGPTService {

    // Replace with your actual OpenAI API key
    private static final OpenAI_Credentials__c creds = OpenAI_Credentials__c.getOrgDefaults();
    private static final String ENDPOINT = 'https://api.openai.com/v1/chat/completions';

    public class Message {
        public String role;
        public String content;

        public Message(String role, String content) {
            this.role = role;
            this.content = content;
        }
    }

    public class RequestBody {
        public String model = 'gpt-4.1-mini'; // Required
        public List<Message> messages = new List<Message>();
    }

    public class Choice {
        public Message message;
    }

    public class CompletionResponse {
        public List<Choice> choices;
    }

    public static String sendPrompt(String prompt) {
        Http http = new Http();
        HttpRequest req = new HttpRequest();
        req.setEndpoint(ENDPOINT);
        req.setMethod('POST');
        req.setHeader('Authorization', 'Bearer ' + creds.API_Key__c);
        req.setHeader('Content-Type', 'application/json');
        req.setTimeout(120000);

        RequestBody body = new RequestBody();
        body.messages.add(new Message('user', prompt));
        String bodyJson = JSON.serialize(body);
        req.setBody(bodyJson);

        HttpResponse res = http.send(req);
        if (res.getStatusCode() != 200) {
            throw new CalloutException('Failed: ' + res.getStatusCode() + ' - ' + res.getBody());
        }

        CompletionResponse result = (CompletionResponse) JSON.deserialize(res.getBody(), CompletionResponse.class);
        return result.choices[0].message.content;
    }
    
