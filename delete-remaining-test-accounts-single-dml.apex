Integer successCount = 0;
Integer failCount = 0;
for (Id accountId : ids) {
    Account acct = [SELECT Id, Name FROM Account WHERE Id = :accountId LIMIT 1];
    Database.DeleteResult result = Database.delete(acct, false);
    if (result.isSuccess()) {
        successCount++;
    } else {
        failCount++;
        for (Database.Error err : result.getErrors()) {
            System.debug('DELETE_FAILED|' + acct.Id + '|' + acct.Name + '|' + err.getStatusCode() + '|' + err.getMessage());
        }
    }
}
System.debug('DELETE_SUMMARY|success=' + successCount + '|failed=' + failCount + '|requested=' + ids.size());
